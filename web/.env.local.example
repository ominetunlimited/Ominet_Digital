# Copy this file to .env.local and fill in real values. .env.local is
# gitignored — never commit real secrets.

# Supabase project (Settings -> API in the dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — bypasses RLS. Used only by the Paystack webhook route.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL — used to build canonical/OG URLs, sitemap.xml and the
# Paystack/auth redirect targets. Set to your real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Paystack (Settings -> API Keys & Webhooks in the Paystack dashboard)
PAYSTACK_SECRET_KEY=
# Also add this same URL as a webhook in the Paystack dashboard:
#   https://<your-domain>/api/webhooks/paystack

# Optional — leave unset to keep ad slots empty (they simply don't render).
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
